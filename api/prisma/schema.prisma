generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  tecnico
}

enum OrderStatus {
  aberto
  em_diagnostico
  aguardando_peca
  pronto
  entregue
}

model User {
  id             String         @id
  name           String
  email          String         @unique
  passwordHash   String
  role           Role
  createdAt      DateTime       @default(now())
  refreshTokens  RefreshToken[]
  assignedOrders ServiceOrder[] @relation("Assignee")
}

model RefreshToken {
  id           String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id        String         @id
  name      String
  phone     String?
  email     String?
  createdAt DateTime       @default(now())
  equipment Equipment[]
  orders    ServiceOrder[]
}

model Equipment {
  id         String         @id
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  brand      String
  model      String
  serial     String?
  orders     ServiceOrder[]

  @@index([customerId])
}

model ServiceOrder {
  id          String       @id
  number      Int          @unique @default(autoincrement())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])
  equipmentId String
  equipment   Equipment    @relation(fields: [equipmentId], references: [id])
  title       String
  description String?
  status      OrderStatus  @default(aberto)
  assigneeId  String?
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  photos      OrderPhoto[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([customerId])
}

model OrderPhoto {
  id          String       @id
  orderId     String
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  objectKey   String
  contentType String
  createdAt   DateTime     @default(now())

  @@index([orderId])
}
